# ============================================================
# BaseOps — Environment Configuration Template
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# - NEVER commit .env or .env.local to Git.
# - NEXT_PUBLIC_* variables are exposed to the browser bundle.
# - Variables WITHOUT NEXT_PUBLIC_ are SERVER-ONLY secrets.
# ============================================================

# ------------------------------------------------------------
# 1. SUPABASE CLIENT-SAFE CONFIGURATION (Browser & Server)
# ------------------------------------------------------------
# For Local Development (Supabase CLI default port 54321):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# For Production (Supabase Cloud project):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# 2. SUPABASE SERVER-ONLY SECRETS (NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------
# Used exclusively in secure server route handlers (/api/invite-team)
# to administratively create users and bypass RLS for trusted RPCs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------
# 3. APPLICATION & ROUTING CONFIGURATION
# ------------------------------------------------------------
# The canonical URL used for generating email links and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super-admin email address authorized to access the /admin portal.
SUPER_ADMIN_EMAIL=admin@baseops.dev

# ------------------------------------------------------------
# 4. EMAIL SERVICE (OPTIONAL FOR LOCAL DEV)
# ------------------------------------------------------------
# Resend API key for sending invitation and magic link emails.
# Leave blank during local dev to use Supabase Inbucket (http://127.0.0.1:54324).
RESEND_API_KEY=
